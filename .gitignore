# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ──────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment / Secrets (NEVER commit) ────────────────────────
.env
!.env.example

# ── Generated by pipeline (too large / reproducible) ────────────
data/raw/
data/staged/
data/curated/
ml_models/
vectorstore/
docs/

# Keep folder structure placeholders
!data/raw/.gitkeep
!data/staged/.gitkeep
!data/curated/.gitkeep
!ml_models/.gitkeep
!vectorstore/.gitkeep
!docs/.gitkeep

# ── Database files ───────────────────────────────────────────────
*.db
*.sqlite3

# ── IDE ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ── Test / Coverage ──────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/

# ── Jupyter ──────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Docker (local only) ──────────────────────────────────────────
.dockerignore

# ── Misc ─────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
