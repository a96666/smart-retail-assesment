# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# Leave blank to use mock LLM responses (TF-IDF RAG fallback)
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ── Azure AI Search (RAG vector store) ───────────────────────────────────────
# Create a free-tier Azure AI Search service and paste the values below.
# If left blank the system falls back to FAISS → TF-IDF automatically.
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_admin_key_here
AZURE_SEARCH_INDEX_NAME=retail-knowledge-base

# ── Azure Blob Storage ────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_BLOB_CONTAINER=smart-retail-ai

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite (default)
# Production: Neon PostgreSQL or Azure SQL
DATABASE_URL=sqlite+aiosqlite:///./data/retail.db

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
